<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.gui</groupId>
        <artifactId>vexelray-gui</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-gui-automation</artifactId>

    <name>VexelRay GUI :: Automation</name>
    <description>Drives a real application the way a person does, for troubleshooting: a stateful pointer
        that never teleports, so hover and enter/leave fire because they were provoked rather than because
        something remembered to simulate them. Input goes out on the ordinary Tactroller topic, which is why
        there is no automation mode for the application to behave differently in. Speaks only bus message
        types, so the same code is a remote peer once the bridge lands. See docs/automation.md.</description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/HoverPathDiagnosisTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- A5 reads its own run back out of the correlation log, and whether the probe is on is
                         decided once in a static initialiser — so it needs a JVM that was started recording.
                         Same reason atchung-probe splits its CSV tests out, and the same shape. -->
                    <execution>
                        <id>correlation</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <probe>input,layout,frame,app</probe>
                                <probe.format>csv</probe.format>
                                <probe.out>target/a5-correlations.csv</probe.out>
                            </systemPropertyVariables>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/HoverPathDiagnosisTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
