<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.gui</groupId>
        <artifactId>vexelray-gui</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-gui-inspector-link</artifactId>

    <name>VexelRay GUI :: Inspector link</name>
    <description>The Inspector's live stream: the flight recorder's rows, loop snapshots and read-only queries, as
        typed intrabuf records over an elektro-Q conduit on a Unix domain socket beside the discovery file (a loopback
        TCP port when the path is too long). One sender thread per Inspector, following the ring with its own cursor,
        so a slow reader slows only itself. Both sides compile against the records here. See
        docs/plans/flight-recorder.md section 6.</description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-recorder</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.elektro.queue</groupId>
            <artifactId>elektroq-core</artifactId>
            <version>${elektroq.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.elektro.queue</groupId>
            <artifactId>elektroq-transport-uds</artifactId>
            <version>${elektroq.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.elektro.queue</groupId>
            <artifactId>elektroq-transport-tcp</artifactId>
            <version>${elektroq.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.intrabuf</groupId>
            <artifactId>intrabuf-runtime</artifactId>
            <version>${intrabuf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>sibarum.intrabuf</groupId>
                            <artifactId>intrabuf-processor</artifactId>
                            <version>${intrabuf.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aintrabuf.buildVersion=${project.version}</arg>
                        <arg>-Aintrabuf.module=${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Discovery files and the link's socket go under target, never into ~/.vexelray. -->
                    <systemPropertyVariables>
                        <vexelray.home>${project.build.directory}/vh</vexelray.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
