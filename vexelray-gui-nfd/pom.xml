<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.gui</groupId>
        <artifactId>vexelray-gui</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-gui-nfd</artifactId>

    <description>
        The GUI's one native binding: a Panama (FFM) facade over nativefiledialog-extended
        (open / save / pick-folder). Asked from any thread; run on a dialog thread of its own on Windows and
        Linux, so the window keeps drawing, and on the GUI thread on macOS, where AppKit requires it. The answer
        is a future completed off the GUI thread. Holds no platform knowledge: the NFDe library and the facts that
        differ per OS come from the vexelray-gui-nfd-&lt;os&gt; module the profiles below add.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-nfd-api</artifactId>
        </dependency>
    </dependencies>

    <!-- Exactly one OS module, picked by the build host's OS, so every application on this facade gets the NFDe
         built for its platform without naming it. -->
    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray.gui</groupId>
                    <artifactId>vexelray-gui-nfd-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray.gui</groupId>
                    <artifactId>vexelray-gui-nfd-linux</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray.gui</groupId>
                    <artifactId>vexelray-gui-nfd-macos</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
