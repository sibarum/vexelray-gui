<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.gui</groupId>
    <artifactId>vexelray-gui</artifactId>
    <version>0.1.3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>vexelray-gui</name>
    <description>
        A GPU-accelerated Java GUI framework built on the VexelRay Vulkan stack. It is a framework only:
        it renders exclusively through VexelRay's native Canvas and owns no rendering, windowing, input,
        or messaging code (except the NFD file-dialog facade). Retained node tree with stable identity,
        mutated through Atchung messages drained on the GUI thread; input arrives as Atchung traffic from
        Tactroller; app logic on worker threads. See docs/architecture.md.
    </description>

    <modules>
        <!-- A picture: marks in one pixel frame, and the two targets that consume one (the engine's Canvas, and
             an SVG writer). Below -core, and depends on no other module. See docs/drawing.md. -->
        <module>vexelray-gui-draw</module>
        <!-- Framework core: retained Node tree, Atchung-backed mutation channel + event/state publishing,
             Length + flex layout, lifecycle FSM + animation transform layer, input dispatch, RichText,
             GuiApp loop. -->
        <module>vexelray-gui-core</module>
        <!-- Build-time icon atlases: art (SVG or raster) into distance fields, an atlas and the enum naming them.
             A Maven plugin, built before the modules that bake with it. See vexelray-gui-icons/README.md. -->
        <module>vexelray-gui-icons-maven-plugin</module>
        <!-- The suite's icons: every drawing in vexelray-icons baked into one atlas of distance fields, and the Icon
             enum that names them. On core only, so widgets can wear them. See vexelray-gui-icons/README.md. -->
        <module>vexelray-gui-icons</module>
        <!-- The file-type families: their sheets and emblems in an atlas of their own, for the one kind of
             application that draws them (a file browser). On core only. See vexelray-gui-file-icons/README.md. -->
        <module>vexelray-gui-file-icons</module>
        <!-- Widgets built on core: box, text, button, slider, list, scroll, text field, ... -->
        <module>vexelray-gui-widget</module>
        <!-- The GUI's one native binding: a Panama nativefiledialog-extended facade. -->
        <module>vexelray-gui-nfd-api</module>
        <module>vexelray-gui-nfd</module>
        <!-- The facade's OS halves: NFDe built for each platform. vexelray-gui-nfd's profiles add one. -->
        <module>vexelray-gui-nfd-windows</module>
        <module>vexelray-gui-nfd-macos</module>
        <module>vexelray-gui-nfd-linux</module>
        <!-- Rebindable key bindings, opt-in: named actions with default chords the user can change, persisted
             through Settings, and the editor (and title-bar instrument) that changes them. On widget. -->
        <module>vexelray-gui-keymap</module>
        <!-- Canonical showcase / reference app. -->
        <module>vexelray-gui-demo</module>
        <!-- Kronometer integration: the strongly-timed scheduling and animation substrate, plus
             interpolation for the GUI's own value types. Enters at the application edge, never in -core. -->
        <module>vexelray-gui-krono</module>
        <!-- Structured, non-editable rich text: a seven-primitive composition IR, tone-mapped type sizes, and a
             projection to floating nodes. A typeset block is an atom in flex layout, never inside a text field.
             See docs/typeset.md. -->
        <module>vexelray-gui-typeset</module>
        <!-- Reliable graphing: an interval-arithmetic enclosure algebra and the expression vocabulary that
             walks onto it. Pure arithmetic — it depends on no other module, and nothing depends on it yet.
             See docs/reliable-plotting.md. -->
        <module>vexelray-gui-plot</module>
        <!-- Drives a real GuiApp loop under a test's control: synthetic input, an observable frame
             budget, and a wait that ends only when something asks for a frame. See docs/render-on-demand. -->
        <module>vexelray-gui-harness</module>
        <!-- The flight recorder: a ring of the probe's recent rows inside the application, and the questions asked
             of it, each answered as a plain record with its text reply a pure function of it. On atchung-probe
             only: no GUI or bus type, so the answers can travel any transport. See docs/plans/flight-recorder.md. -->
        <module>vexelray-gui-recorder</module>
        <!-- Drives a real application for troubleshooting: a pointer that never teleports, so the hover a
             bug depended on is actually provoked. Speaks only bus types. See docs/automation.md. -->
        <module>vexelray-gui-automation</module>
        <!-- The client for that protocol: a command line that attaches to a running application, or launches
             one. Empty dependency block, so it runs with none of the stack on its classpath — beside the
             server so the reader cannot drift from the format. See docs/automation-cli.md. -->
        <module>vexelray-gui-automation-cli</module>
        <!-- The Inspector's link: the recorder's rows, snapshots and read-only queries as typed intrabuf records over
             elektro-Q, on a Unix domain socket beside the discovery file. Its own module so the automation server
             and ottermate stay free of elektro-Q. See docs/plans/flight-recorder.md section 6. -->
        <module>vexelray-gui-inspector-link</module>
        <!-- The automation sockets switched by hand while the application runs: remote control and diagnostics,
             each on or off, on one port or two. A window behind a title-bar instrument beside the key bindings.
             Its own module so the automation server stays free of widgets. See docs/reference/automation.md §5. -->
        <module>vexelray-gui-automation-window</module>
        <!-- Test-only: the automated separation-of-concerns guard (docs/architecture-proof-plan.md M0).
             Last, so it inspects the compiled output of everything above it. -->
        <module>vexelray-gui-architecture</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- VexelRay: the Vulkan engine we build on. Installed to the local .m2 by `mvn install` in the
             sibling vexelray repo (which in turn requires SupirVast installed first). -->
        <vexelray.version>0.1.3-SNAPSHOT</vexelray.version>
        <!-- SupirVast: transitive via VexelRay; pinned for any incidental direct use. Must match vexelray's own
             supirvast.version: this pin is in dependencyManagement, so it wins over the transitive one here. -->
        <supirvast.version>0.2.3-SNAPSHOT</supirvast.version>
        <!-- Atchung: the message bus the model + threading are built on (core to -core). -->
        <atchung.version>1.3-SNAPSHOT</atchung.version>
        <!-- elektro-Q and intrabuf: the Inspector link's wire (vexelray-gui-inspector-link only). elektro-Q lives in
             the atchung checkout, under elektroq/. -->
        <elektroq.version>1.3-SNAPSHOT</elektroq.version>
        <intrabuf.version>0.1.3-SNAPSHOT</intrabuf.version>
        <!-- Tactroller: keyboard/mouse/pointer/clipboard input, delivered as Atchung traffic. Enters at
             the application edge (the demo), not in -core. -->
        <tactroller.version>1.3-SNAPSHOT</tactroller.version>
        <!-- Kronometer: logical time, rate domains, the signal graph. Application edge only. -->
        <kronometer.version>1.3-SNAPSHOT</kronometer.version>
        <!-- imagelib: Panama bindings over one C ABI for every image format (PNG/JPEG/GIF/WebP/... and SVG).
             Application edge only, and deliberately: decoding is not this framework's business, and no module
             here names a format at run time. The demo depends on it to show what GuiApp.texture is for, and the
             icon plugin reads art with it at build time. -->
        <imagelib.version>0.1.3-SNAPSHOT</imagelib.version>
        <joml.version>1.10.7</joml.version>
        <junit.version>5.11.4</junit.version>
        <!-- ASM: bytecode reading for the architecture guard (test scope), and the icon plugin's descriptor scan. -->
        <asm.version>9.9.1</asm.version>
        <!-- Maven plugin tooling, for vexelray-gui-icons-maven-plugin. -->
        <maven-plugin-api.version>3.9.9</maven-plugin-api.version>
        <maven-plugin-tools.version>3.15.1</maven-plugin-tools.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The stack-wide profiling seam (see sibarum.probe.Probe). No dependencies of its own. -->
            <dependency>
                <groupId>sibarum.atchung</groupId>
                <artifactId>atchung-probe</artifactId>
                <version>1.3-SNAPSHOT</version>
            </dependency>
            <!-- Reactor-internal modules: children reference these without a version. -->
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-draw</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-icons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-file-icons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-widget</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-recorder</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-automation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-nfd</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-nfd-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-nfd-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-nfd-macos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-nfd-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-keymap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-automation-window</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-typeset</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-plot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-krono</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- VexelRay engine artifacts (from the sibling repo's install). The GUI draws through
                 -canvas, lays text with -text, drives the runtime via -vulkan, and windows/inputs via -os. -->
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-canvas</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <!-- The canvas's effect shadelets: depended on for their style records and names, which a look uses;
                 an application composes them into its shader, or its looks draw without them. -->
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-shadelets</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <!-- How a seam says it has silently dropped something the consumer asked for. Depends on nothing. -->
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-diagnostics</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-text</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-vulkan</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-os-api</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-os-windows</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-os-linux</artifactId>
                <version>${vexelray.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-os-macos</artifactId>
                <version>${vexelray.version}</version>
            </dependency>

            <!-- The message bus: mutations, input, and app events all ride Atchung (architecture.md §4-5). -->
            <dependency>
                <groupId>sibarum.atchung</groupId>
                <artifactId>atchung-core</artifactId>
                <version>${atchung.version}</version>
            </dependency>

            <!-- Input middleware + its Atchung bridge. Consumed at the application edge (demo). -->
            <dependency>
                <groupId>sibarum.tactroller</groupId>
                <artifactId>tactroller-api</artifactId>
                <version>${tactroller.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.tactroller</groupId>
                <artifactId>tactroller-atchung</artifactId>
                <version>${tactroller.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.tactroller</groupId>
                <artifactId>tactroller-windows</artifactId>
                <version>${tactroller.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.tactroller</groupId>
                <artifactId>tactroller-clipboard</artifactId>
                <version>${tactroller.version}</version>
            </dependency>

            <dependency>
                <groupId>sibarum.imagelib</groupId>
                <artifactId>imagelib-wrapper</artifactId>
                <version>${imagelib.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vastir</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <dependency>
                <groupId>org.joml</groupId>
                <artifactId>joml</artifactId>
                <version>${joml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <!-- Explicit release on the plugin (not only the maven.compiler.release property) so IDEs
                         pick up the Java 25 language level reliably. Sourced from the property. -->
                    <configuration>
                        <target>${maven.compiler.release}</target>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>dev.vexelray.gui</groupId>
                    <artifactId>vexelray-gui-icons-maven-plugin</artifactId>
                    <version>${project.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Stamps this build with the exact source of its binaries (the commit, plus a digest of any uncommitted
                 change), so whatever is built on it knows what it was built from. See vexelray-build/README.md. -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.3-SNAPSHOT</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>identify</goal>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The demo runs via `exec:exec` (see vexelray-gui-demo). Declared here with skip=true and a
                 valid executable so a reactor build never launches it on the aggregator or siblings; the
                 demo module un-skips it. Same pattern as VexelRay's root pom. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <skip>true</skip>
                    <executable>${java.home}/bin/java</executable>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
