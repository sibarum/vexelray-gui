<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.gui</groupId>
        <artifactId>vexelray-gui</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vexelray-gui-demo</artifactId>

    <description>
        Canonical showcase / reference app for vexelray-gui. Also the example of how a client app is
        configured: it depends on -widget + -nfd and selects its VexelRay platform module at build time
        via the same OS-activated profiles VexelRay uses.
    </description>

    <properties>
        <demo.mainClass>dev.vexelray.gui.demo.Demo</demo.mainClass>
        <!--
          Program args for exec:exec, split on whitespace: empty is the interactive showcase, and a
          multi-word value (the capture flag, a filename and a chapter index) is three arguments rather
          than one. See the plugin configuration below.
        -->
        <demo.args></demo.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-nfd</artifactId>
        </dependency>
        <!-- Two optional modules the gallery gives a chapter each. Neither is reachable through -widget, and
             that is deliberate: typeset is a second composition world a flex layout embeds as an atom, and
             plot is arithmetic with no renderer at all, so the chapter draws its output itself, which is the
             thing that chapter is about. An application that wants neither depends on neither. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-typeset</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-plot</artifactId>
        </dependency>
        <!-- The clock. Motion enters at the application edge and nowhere else: -widget declares seams shaped
             out of JDK types (a DoubleConsumer and a Runnable) and this module satisfies them, so a widget
             animates without ever naming Kronometer. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
        </dependency>
        <!-- The application edge for input: the tactroller->atchung bridge (brings tactroller-api +
             atchung-core transitively). The GUI core knows only the input topic contract; the demo owns
             the concrete input source and hands the GUI the same bus. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
        </dependency>
        <!-- Standalone OS clipboard for text widgets (cut/copy/paste); no input-subsystem coupling. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Run the demo in a fresh JVM: mvn -pl vexelray-gui-demo -am compile exec:exec
              exec:exec (not exec:java) runs a separate JVM so we can enable native access for Panama FFM.
              Version + default skip=true come from the root pluginManagement; this module un-skips it.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <!--
                      One command line, split on whitespace, rather than a list of argument elements.

                      An argument element is exactly one token and a property cannot expand into several, so a
                      multi-word demo.args arrived as a single argument and Demo read the whole string as a
                      frame count: every capture form the README documents was unrunnable as written. This form
                      is split, so a multi-word demo.args means what it says, and an empty one contributes no
                      token at all, which is the interactive run.

                      %classpath is exec:exec's own token for the runtime classpath. It is substituted after
                      the split, so it stays a single argument even where a path contains a space.
                    -->
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -classpath %classpath ${demo.mainClass} ${demo.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native image: mvn -Pnative -pl vexelray-gui-demo -am package  ->  target/vexelray-demo(.exe)
          Profile-gated because native-image takes minutes and needs a GraalVM JDK; an ordinary `package` on a
          stock JDK must not pay for (or fail on) it. FFM downcall metadata is expected under
          src/main/resources/META-INF/native-image/ (generate with a -agentlib:native-image-agent run).
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>vexelray-demo</imageName>
                            <mainClass>dev.vexelray.gui.demo.Demo</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:+ForeignAPISupport</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/supirvast/shaders/.*</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Build-time platform selection: exactly one activates from the host OS, adding VexelRay's
             matching provider module at runtime (ServiceLoader picks it up via NativePlatform.current()). -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <!-- The tactroller input backend for this OS (ServiceLoader picks it up). -->
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
