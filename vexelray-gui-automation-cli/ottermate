#!/bin/sh
# ottermate, as a command rather than as a path to a jar.
#
# Every example in docs/automation-cli.md is written `ottermate shot after.png`, and until this existed the
# only way to run it was to type the jar's full path with its version in it -- so the tool that was built to
# fix a reachability defect had one of its own. Put this module's directory on PATH once and the docs become
# runnable as written.
#
# Nothing here is a launcher in the wrapper-script sense: no classpath assembly, no JAVA_OPTS, no config file.
# The jar is executable on its own (an empty dependency block is what buys that, pom.xml), so this finds it,
# runs it, and gets out of the way. Anything that accumulated here would be state the jar does not have,
# which is how `java -jar` and `ottermate` start behaving differently.

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Globbed rather than named: the version is the parent pom's and moves. Newest first, so a rebuild under a
# bumped version wins over the stale jar beside it rather than being picked by lexical accident. The filter
# is for the -sources and -javadoc jars a release build leaves in the same directory; neither has a manifest
# to run, and picking one gives "no main manifest attribute", which reads as a broken tool.
jar=$(ls -t "$here"/target/vexelray-gui-automation-cli-*.jar 2>/dev/null \
        | grep -v -e '-sources\.jar$' -e '-javadoc\.jar$' \
        | head -1)

if [ -z "$jar" ]; then
    # 127 rather than one of the tool's own five statuses (0 ok, 1 err, 2 usage, 3 nothing to drive, 4 it went
    # away). None of them fits -- the socket was never reached to have an opinion -- and 127 is the shell's
    # own "not installed", which is exactly what happened.
    echo "ottermate: not built. From the vexelray-gui root:" >&2
    echo "    mvn -pl vexelray-gui-automation-cli package" >&2
    echo "No -am: this module depends on nothing, so the rest of the reactor is not involved." >&2
    exit 127
fi

# exec, so the exit status is the tool's own and not a copy of it. The status *is* the verdict
# (docs/automation-cli.md §10) -- a wrapper that returned its own would be a script silently deciding that
# every run succeeded.
exec java -jar "$jar" "$@"
