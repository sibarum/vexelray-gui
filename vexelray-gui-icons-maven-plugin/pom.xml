<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.gui</groupId>
        <artifactId>vexelray-gui</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-gui-icons-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <description>
        Build-time icon atlases: what vexelray-msdf-maven-plugin is to the fonts, this is to the icons. The bake goal
        reads art (SVG, a black-on-white raster, or a raster whose alpha is the shape), makes each drawing a signed
        distance field, packs them into one atlas, and generates the enum that names them, so an application draws
        any of them at any size and colour through IconSource and nothing at run time reads an image format. A set
        can extend another (the suite's shared set in vexelray-gui-icons): it takes that set's grids and may not
        reuse its names. The file-families goal bakes the file-type families' sheets and emblems.
        See vexelray-gui-icons/README.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Every format a drawing can come in, SVG and raster, through one C ABI; its DLL is extracted from the jar. -->
        <dependency>
            <groupId>sibarum.imagelib</groupId>
            <artifactId>imagelib-wrapper</artifactId>
        </dependency>
        <!-- DistanceField: the one place a mask becomes a field, which the run time's icon path also uses. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-canvas</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- imagelib's downcalls, which the tests read real SVG and PNG files through. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-tools.version}</version>
                <configuration>
                    <goalPrefix>vexelray-icons</goalPrefix>
                </configuration>
                <!-- The descriptor scanner's own ASM cannot read JDK 25 class files; vexelray-msdf-maven-plugin
                     answers that by compiling to 21, which this one cannot, since what it calls is built for 25. -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
