<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.gui</groupId>
        <artifactId>vexelray-gui</artifactId>
        <version>0.1.2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vexelray-gui-demo</artifactId>

    <description>
        Canonical showcase / reference app for vexelray-gui. Also the example of how a client app is
        configured: it depends on -widget + -nfd and selects its VexelRay platform module at build time
        via the same OS-activated profiles VexelRay uses.
    </description>

    <properties>
        <demo.mainClass>dev.vexelray.gui.demo.Demo</demo.mainClass>
        <!--
          Program args for exec:exec, split on whitespace: empty is the interactive showcase, and a
          multi-word value (the capture flag, a filename and a chapter index) is three arguments rather
          than one. See the plugin configuration below.
        -->
        <demo.args></demo.args>
        <!--
          Extra JVM flags for exec:exec, split on whitespace like demo.args.

          Needed because a -D on the mvn command line sets a *Maven* property, and the commandlineArgs below
          is a fixed string: nothing on that command line reaches the JVM, so `mvn exec:exec -Dsome.knob=48`
          runs the demo with the default and reports a measurement of nothing. That is not hypothetical — a
          seven-configuration performance sweep on this framework produced one identical number seven times
          for exactly this reason, and was believed. Pass flags through here instead:

              mvn -pl vexelray-gui-demo exec:exec -Ddemo.jvmArgs="-Dsome.knob=48 -Xmx2g"
        -->
        <demo.jvmArgs></demo.jvmArgs>
        <!--
          The automation socket, control and diagnostics on one port: off, on (port 7654), 0 (a free port,
          announced on stdout as "automation: localhost:<port>", the line ottermate's launch option reads), or
          a port. Its own property rather than one more demo.jvmArgs, so the run the ottermate guide gives works
          here as written: mvn exec:exec -Dautomation=0. Each alone is -Dautomation.control or
          -Dautomation.diagnostics, through demo.jvmArgs; and the title bar's automation button switches either
          while the gallery runs. (No command line is quoted here in full, because one of its flags would end
          this comment.)
        -->
        <automation>off</automation>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-nfd</artifactId>
        </dependency>
        <!-- Rebindable zoom chords, and the title-bar key button that changes them. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-keymap</artifactId>
        </dependency>
        <!-- The driving socket, off unless -Dautomation asks for it: what lets ottermate photograph a chapter
             mid-gesture (a card half-carried, a menu open) rather than only at rest, which is all capture can. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
        </dependency>
        <!-- The title-bar button beside the key bindings that switches remote control and diagnostics while the
             gallery runs. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation-window</artifactId>
        </dependency>
        <!-- And the Inspector's link beside it, on whenever diagnostics is: the recorder's rows as typed records over
             elektro-Q (docs/plans/flight-recorder.md section 6). -Dautomation.link=off leaves it out. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-inspector-link</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Two optional modules the gallery gives a chapter each. Neither is reachable through -widget, and
             that is deliberate: typeset is a second composition world a flex layout embeds as an atom, and
             plot is arithmetic with no renderer at all, so the chapter draws its output itself, which is the
             thing that chapter is about. An application that wants neither depends on neither. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-typeset</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-plot</artifactId>
        </dependency>
        <!-- The clock. Motion enters at the application edge and nowhere else: -widget declares seams shaped
             out of JDK types (a DoubleConsumer and a Runnable) and this module satisfies them, so a widget
             animates without ever naming Kronometer. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
        </dependency>
        <!-- The application edge for input: the tactroller->atchung bridge (brings tactroller-api +
             atchung-core transitively). The GUI core knows only the input topic contract; the demo owns
             the concrete input source and hands the GUI the same bus. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
        </dependency>
        <!-- Standalone OS clipboard for text widgets (cut/copy/paste); no input-subsystem coupling. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
        </dependency>
        <!-- Decoding, at the application edge where it belongs. The framework supplies GuiApp.texture and
             takes RGBA8; what turns a PNG or an SVG into RGBA8 is the application's affair, and no module in
             this repo names an image format. ImageChapter is the worked example of that division. Carries a
             native library of its own (extracted from its jar and loaded at first use). -->
        <dependency>
            <groupId>sibarum.imagelib</groupId>
            <artifactId>imagelib-wrapper</artifactId>
        </dependency>
        <!-- The canvas's effects, which DemoShader composes into the one shader every window and capture draws
             with. Reachable through -icons already; named here because the demo names Effects itself. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-shadelets</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The mark, on the class path for the window: the same file src/main/rc/vexelray-demo.rc links into the
                 executable, so the two are one file and cannot drift. Under demo/ so the native image's existing
                 demo/* resource glob carries it. -->
            <resource>
                <directory>src/main/rc</directory>
                <targetPath>demo</targetPath>
                <includes>
                    <include>vexelray-demo.ico</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!--
              Pre-compile DemoShader, the demo's composed canvas shader, to SPIR-V at build time, as vexelray-canvas
              does its own: META-INF/supirvast/shaders/canvas.frag.<hash>.spv in this jar. Without it the shader is
              lowered on the main thread at startup, and said to be. The plugin scans this module's classes for
              shaders, so the composition has to be a class here with a public no-arg constructor.
            -->
            <plugin>
                <groupId>dev.supirvast</groupId>
                <artifactId>supirvast-maven-plugin</artifactId>
                <version>${supirvast.version}</version>
                <executions>
                    <execution>
                        <id>precompile-shaders</id>
                        <goals>
                            <goal>compile-shaders</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Run the demo in a fresh JVM: mvn -pl vexelray-gui-demo -am compile exec:exec
              exec:exec (not exec:java) runs a separate JVM so we can enable native access for Panama FFM.
              Version + default skip=true come from the root pluginManagement; this module un-skips it.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <!--
                      One command line, split on whitespace, rather than a list of argument elements.

                      An argument element is exactly one token and a property cannot expand into several, so a
                      multi-word demo.args arrived as a single argument and Demo read the whole string as a
                      frame count: every capture form the README documents was unrunnable as written. This form
                      is split, so a multi-word demo.args means what it says, and an empty one contributes no
                      token at all, which is the interactive run.

                      %classpath is exec:exec's own token for the runtime classpath. It is substituted after
                      the split, so it stays a single argument even where a path contains a space.
                    -->
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dautomation=${automation} "-Dbuild.dir=${project.build.directory}" ${demo.jvmArgs} -classpath %classpath ${demo.mainClass} ${demo.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native image: mvn -Pnative -pl vexelray-gui-demo -am package  ->  target/vexelray-demo(.exe)
          Profile-gated because native-image takes minutes and needs a GraalVM JDK; an ordinary `package` on a
          stock JDK must not pay for (or fail on) it. It runs rc.exe for the icon (src/main/rc), so run it from a
          Visual Studio developer prompt. The libraries carry their own metadata (FFM flags, downcalls,
          shaders, fonts); the demo's own is under src/main/resources/META-INF/native-image/ (traced with a
          -agentlib:native-image-agent run, then trimmed of what the libraries list).
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>vexelray-demo</imageName>
                            <mainClass>dev.vexelray.gui.demo.Demo</mainClass>
                            <buildArgs>
                                <!-- The FFM flags, the shaders, the font atlas and nfd.dll come from the libraries'
                                     own META-INF/native-image metadata. The demo's own metadata lists its assets
                                     (demo/) and imagelib's DLL: both are read as classpath resources at runtime,
                                     so an image that leaves them out fails at first decode rather than at build.
                                     imagelib leaves embedding its DLL to the application, since one that links
                                     imagelib in has no DLL to extract. -->
                                <buildArg>--no-fallback</buildArg>
                                <!-- The executable's icon (src/main/rc), compiled to a .res by rc.exe below. -->
                                <buildArg>-H:NativeLinkerOption=${project.build.directory}/vexelray-demo.res</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <!-- The executable's icon: a resource linked into the program, so it has to exist as a compiled
                         .res before link time. rc.exe is the Windows SDK's resource compiler and must be on PATH, as
                         it is in a Visual Studio developer prompt (which the native build already needs for
                         link.exe). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>compile-icon-resource</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <exec executable="rc.exe" searchpath="true" failonerror="true">
                                            <arg value="/nologo"/>
                                            <arg value="/fo"/>
                                            <arg file="${project.build.directory}/vexelray-demo.res"/>
                                            <arg file="${project.basedir}/src/main/rc/vexelray-demo.rc"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Build-time platform selection: exactly one activates from the host OS, adding VexelRay's
             matching provider module at runtime (ServiceLoader picks it up via NativePlatform.current()). -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <!-- The tactroller input backend for this OS (ServiceLoader picks it up). -->
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
